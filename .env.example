# PostgreSQL connection string (Azure Database for PostgreSQL, Neon, or any Postgres)
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Random long string used to sign session cookies (generate once, keep secret)
SESSION_SECRET=

# Google Sheets submission (service account with Sheets API access)
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=

# Set by Azure App Service automatically; only needed for local dev
PORT=5000
NODE_ENV=development
